{
  "name": "uw2-combat-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side Ultima Underworld II skill check and combat simulator, rules ported from abedegno/underworld-exhumed",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:c": "node test/c/run-c-checks.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/katex": "0.16.7",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "dependencies": {
    "d3": "7.9.0",
    "katex": "0.16.11"
  }
}
